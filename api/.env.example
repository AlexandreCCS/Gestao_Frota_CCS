# [09/05/2026 - Alexandre Carvalho] Variaveis de ambiente da frota-api
# Copie para .env e preencha. NUNCA versionar .env.

# ----- Servidor -----
PORT=3030
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ----- JWT -----
JWT_SECRET=troque-em-producao-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=12h

# ----- Tenant central (Postgres na VPS srv-ccs) -----
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5435
TENANT_DB_NAME=frota_tenant
TENANT_DB_USER=frota
TENANT_DB_PASSWORD=preencher

# ----- Bridge SOAP Oracle Mega (apiquality1) -----
# Em producao, usuario/senha sao definidos por cliente no tenant central.
# Estas variaveis aqui sao apenas fallback / dev.
SOAP_HOST=apiquality1.ccstecno.com.br
SOAP_PATH=/webService.asmx
SOAP_NAMESPACE=http://tempuri.org/
SOAP_TIMEOUT_MS=30000

# ----- CORS -----
# Lista separada por virgula. Em dev, deixar permissivo. Em prod, dominio especifico.
CORS_ORIGIN=http://localhost:3031,http://127.0.0.1:3031
